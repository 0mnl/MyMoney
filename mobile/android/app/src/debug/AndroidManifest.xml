<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Незашифрованный HTTP разрешён ТОЛЬКО в debug-сборке: локальный
         бэкенд на 10.0.2.2:8080 живёт без TLS, и иначе его не отладить.
         В основном манифесте стоит usesCleartextTraffic="false", поэтому
         релизный APK обязан ходить по https — случайная сборка, отправляющая
         пароли открытым текстом, не соберётся работающей. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
