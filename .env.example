# Скопируйте этот файл в .env и поправьте под своё окружение:
#     cp .env.example .env
# .env в .gitignore — реальные секреты в git не попадут.
#
# Файл читают и docker-compose, и бэкенд (через application.conf: каждое
# значение там переопределяется одноимённой переменной окружения).
#
# На сервере файл должен принадлежать сервисному пользователю и иметь права
# 600 — внутри лежат пароль БД, JWT-секрет и пароль SMTP:
#     chown mymoney:mymoney .env && chmod 600 .env

# === Postgres (используется docker-compose и бэкендом) ===
POSTGRES_DB=mymoney
POSTGRES_USER=mymoney
POSTGRES_PASSWORD=mymoney_dev_password
# ВАЖНО: порт должен совпадать с портом в DB_URL ниже.
# Если 5432 уже занят локальным Postgres — возьмите свободный (5434 и т.п.)
# и обязательно поправьте оба места. Подробности — HOWTO_RUN.md § 2.2.
POSTGRES_PORT=5432
# Интерфейс, на котором публикуется порт Postgres. НА СЕРВЕРЕ НЕ МЕНЯТЬ:
# 0.0.0.0 откроет базу в интернет в обход UFW (Docker пишет правила в
# цепочку DOCKER, которую iptables проходит раньше правил UFW).
POSTGRES_BIND=127.0.0.1

# === Backend ===
# APP_ENV=production включает fail-safe для JWT_SECRET и DB_PASSWORD:
# приложение откажется стартовать, если оставлены дефолтные значения.
APP_ENV=development
PORT=8080
BACKEND_PORT=8080
# Аналогично POSTGRES_BIND: наружу API отдаёт nginx, сам контейнер слушает
# только loopback. Иначе API доступен по http://IP:8080 мимо TLS и rate-limit.
BACKEND_BIND=127.0.0.1
DB_URL=jdbc:postgresql://localhost:5432/mymoney
DB_USER=mymoney
DB_PASSWORD=mymoney_dev_password
DB_POOL_SIZE=10

# === JWT ===
# Для любого не-dev окружения сгенерируйте сильный секрет:
#   openssl rand -base64 48
# В production обязательно >= 32 символов и НЕ дефолтное значение ниже.
JWT_SECRET=dev-only-change-me-in-production
JWT_ISSUER=mymoney
JWT_AUDIENCE=mymoney-mobile
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# === Кто может регистрироваться ===
# Через запятую: полный адрес (ivan@example.com) или домен (@example.com —
# пускает всех его владельцев). Регистр не важен.
#
# ПУСТО = регистрация открыта любому, кто знает адрес сервера. Бэкенд пишет
# об этом WARN при старте. Для раздачи APK ограниченному кругу — перечислите
# адреса тестировщиков здесь и перезапустите контейнер.
REGISTRATION_ALLOWLIST=

# === Почта (коды подтверждения email) ===
# Пока MAIL_HOST пуст, работает LoggingVerificationCodeSender: коды пишутся
# в лог приложения, письма НЕ отправляются. Для dev этого достаточно.
# В production сервер откажется стартовать без настроенной почты —
# иначе пользователи не смогут подтвердить регистрацию.
#
# --- Gmail с паролем приложения ---
# 1. На аккаунте Google включить двухфакторную аутентификацию (без неё
#    пункта с паролями приложений просто нет).
# 2. https://myaccount.google.com/apppasswords → создать пароль для «Почта».
# 3. Полученные 16 символов (без пробелов) — в MAIL_PASSWORD.
# 4. MAIL_USERNAME и MAIL_FROM должны быть одним и тем же адресом: Gmail не
#    даст отправлять письма «от» чужого адреса и вернёт 553.
# Лимит Gmail — порядка 500 писем в сутки, для круга тестировщиков хватает
# с запасом. Обычный пароль от аккаунта здесь работать НЕ будет.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@mymoney.local
MAIL_FROM_NAME=MyMoney
# STARTTLS (587) — обычный выбор, и именно его использует Gmail.
# Для implicit TLS на 465 поставьте MAIL_STARTTLS=false и MAIL_SSL=true.
MAIL_STARTTLS=true
MAIL_SSL=false

# === CORS ===
# Источники для браузерных клиентов, через запятую (https://app.example.com).
# Мобильному приложению не нужно: CORS проверяет браузер, а не Dio.
# ПУСТО в production = плагин CORS не ставится вовсе, и это правильный
# режим, пока нет веб-клиента.
HTTP_ALLOWED_ORIGINS=
