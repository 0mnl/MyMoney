# Copy this file to .env and adjust values for your local setup.
# .env is gitignored — never commit real secrets.

# === Postgres (used by docker-compose and backend) ===
POSTGRES_DB=mymoney
POSTGRES_USER=mymoney
POSTGRES_PASSWORD=mymoney_dev_password
POSTGRES_PORT=5432

# === Backend ===
# APP_ENV=production включает fail-safe для JWT_SECRET и DB_PASSWORD:
# приложение откажется стартовать, если оставлены дефолтные значения.
APP_ENV=development
PORT=8080
BACKEND_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/mymoney
DB_USER=mymoney
DB_PASSWORD=mymoney_dev_password
DB_POOL_SIZE=10

# === JWT ===
# Generate a strong random secret for any non-dev environment:
#   openssl rand -base64 48
# В production обязательно >= 32 символов и НЕ дефолтное значение ниже.
JWT_SECRET=dev-only-change-me-in-production
JWT_ISSUER=mymoney
JWT_AUDIENCE=mymoney-mobile
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
